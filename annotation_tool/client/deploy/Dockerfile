FROM node:20.10.0-slim AS builder

WORKDIR /usr/app

ARG REACT_APP_SERVER_URL
ARG REACT_APP_TARGET_LANGUAGE
ARG REACT_APP_CONTACT_NAME
ARG REACT_APP_CONTACT_EMAIL

ENV REACT_APP_SERVER_URL=$REACT_APP_SERVER_URL
ENV REACT_APP_TARGET_LANGUAGE=$REACT_APP_TARGET_LANGUAGE
ENV REACT_APP_CONTACT_NAME=$REACT_APP_CONTACT_NAME
ENV REACT_APP_CONTACT_EMAIL=$REACT_APP_CONTACT_EMAIL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /usr/app/build /usr/share/nginx/html

EXPOSE 80
